# Copy to .env and fill in. `just` loads this file automatically.

# GitHub: classic token with `repo` scope (read access incl. private repos in any org),
# or a fine-grained token with read-only "Pull requests" + "Contents" + "Metadata".
PRWATCH_GITHUB_TOKEN=

# GitLab: personal access token with the `read_api` scope.
PRWATCH_GITLAB_TOKEN=
# PRWATCH_GITLAB_URL=https://gitlab.com
