# Copy to .env and fill in. `just` loads this file automatically.
# Configure only the platforms you use; instances without a token are skipped.

# GitHub: classic token with `repo` scope (read access incl. private repos in any org),
# or a fine-grained token with read-only "Pull requests" + "Contents" + "Metadata".
PRWATCH_GITHUB_TOKEN=
# PRWATCH_GITHUB_URL=https://github.com          # or your GitHub Enterprise Server URL

# GitLab: personal access token with the `read_api` scope.
PRWATCH_GITLAB_TOKEN=
# PRWATCH_GITLAB_URL=https://gitlab.com          # or your self-hosted GitLab URL

# More instances: repeat the TOKEN/URL pair with a suffix of your choice (letters, digits, _).
# PRWATCH_GITLAB_TOKEN_ARCH=
# PRWATCH_GITLAB_URL_ARCH=https://gitlab.archlinux.org
# PRWATCH_GITHUB_TOKEN_WORK=
# PRWATCH_GITHUB_URL_WORK=https://github.example.com
